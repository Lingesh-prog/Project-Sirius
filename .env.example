# SIRIUS AI settings (Module 2.1).
# Copy this file to .env, fill in your key, and never commit the real .env.
# SIRIUS reads plain environment variables; no .env loader is required.

# AI provider to use. Currently supported: gemini
SIRIUS_AI_PROVIDER=gemini

# Required for AI features: your Google AI Studio API key.
SIRIUS_GEMINI_API_KEY=your-gemini-api-key-here

# Optional model override (defaults to gemini-3.7-flash).
SIRIUS_GEMINI_MODEL=gemini-3.7-flash
